<%
  /* ─── Helpers ─────────────────────────────────────────────────── */
  const role        = (currentUser && currentUser.role) ? currentUser.role : 'USER';
  const userName    = (currentUser && currentUser.name) ? currentUser.name : 'User';
  const userIdVal   = (currentUser && (currentUser.userId || currentUser._id)) ? (currentUser.userId || currentUser._id) : '';

  /* Current path */
  const cur = typeof currentPath !== 'undefined' ? currentPath : (typeof current !== 'undefined' ? current : (locals.current || '/'));

  function isActive(href) {
    if (!href || href === '#') return false;
    if (href === '/dashboard/central' && cur === '/dashboard/central') return true;
    if (href === '/dashboard/state' && cur === '/dashboard/state') return true;
    if (href === '/dashboard/district' && cur === '/dashboard/district') return true;
    if (href.startsWith('/dashboard') && cur === href) return true;
    if (href === '/land/requests' && (cur === '/land/requests' || cur.startsWith('/land/requests?'))) return true;
    if (href === '/verification/queue' && cur.startsWith('/verification')) return true;
    if (href === '/map' && cur.startsWith('/map')) return true;
    if (href === '/compensation' && cur.startsWith('/compensation')) return true;
    if (href === '/audit' && cur.startsWith('/audit')) return true;
    return cur === href;
  }

  function linkCls(href) {
    return isActive(href)
      ? 'bg-[#207E85] text-white font-semibold shadow-sm'
      : 'text-slate-300 hover:bg-[#243650] hover:text-white transition-colors';
  }
%>

