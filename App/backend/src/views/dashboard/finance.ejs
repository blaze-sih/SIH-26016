<!-- Finance Officer Compensation Dashboard -->
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Finance & Compensation Dashboard</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">Finance Officer</span>
      </div>
      <p class="text-sm text-slate-500 mt-1">Direct benefit transfer tracking, compensation assessments, and disbursements to affected land owners</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/compensation/list" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-sm transition flex items-center gap-2">
        <span>Disbursement Register</span>
      </a>
    </div>
  </div>

  <!-- KPI Metrics Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Assessed</div>
      <div class="mt-2 text-2xl font-extrabold text-slate-900">₹ <%= (totalAssessedAmount || 0).toLocaleString('en-IN') %></div>
      <div class="mt-1 text-xs text-slate-400">Total award assessed</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Total Paid</div>
      <div class="mt-2 text-2xl font-extrabold text-emerald-600">₹ <%= (totalPaidAmount || 0).toLocaleString('en-IN') %></div>
      <div class="mt-1 text-xs text-slate-400">Disbursed via RTGS/NEFT</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-xs font-semibold text-amber-600 uppercase tracking-wider">Pending Processing</div>
      <div class="mt-2 text-2xl font-extrabold text-amber-600"><%= pendingDisbursements || 0 %></div>
      <div class="mt-1 text-xs text-slate-400">Approved, awaiting transfer</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Beneficiaries Paid</div>
      <div class="mt-2 text-2xl font-extrabold text-blue-600"><%= paidCount || 0 %></div>
      <div class="mt-1 text-xs text-slate-400">Land owners settled</div>
    </div>
  </div>

  <!-- Compensation Records Table -->
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-bold text-slate-900">Compensation Award Records</h2>
      <a href="/compensation/list" class="text-xs font-semibold text-emerald-600 hover:text-emerald-500">View All →</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs data-table">
        <thead>
          <tr>
            <th>Request ID</th>
            <th>Beneficiary Owner</th>
            <th>Assessed Amount</th>
            <th>Approved Amount</th>
            <th>Payment Status</th>
            <th>Payment Reference</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (compensations && compensations.length > 0) { %>
            <% compensations.forEach(comp => { %>
              <tr>
                <td class="font-mono font-semibold text-blue-600">
                  <a href="/land/<%= comp.requestId %>" class="hover:underline"><%= comp.requestId %></a>
                </td>
                <td class="font-medium text-slate-800"><%= comp.ownerName || '—' %></td>
                <td class="font-mono font-semibold">₹ <%= (comp.assessedAmount || 0).toLocaleString('en-IN') %></td>
                <td class="font-mono font-semibold text-emerald-700">₹ <%= (comp.approvedAmount || comp.assessedAmount || 0).toLocaleString('en-IN') %></td>
                <td>
                  <% const ps = (comp.paymentStatus || 'ASSESSED').toUpperCase(); %>
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold <%= ps === 'PAID' ? 'bg-emerald-100 text-emerald-800' : ps === 'PROCESSING' ? 'bg-blue-100 text-blue-800' : ps === 'APPROVED' ? 'bg-teal-100 text-teal-800' : 'bg-amber-100 text-amber-800' %>">
                    <%= ps %>
                  </span>
                </td>
                <td class="font-mono text-[11px] text-slate-500"><%= comp.paymentReference || 'PENDING' %></td>
                <td>
                  <a href="/compensation/<%= comp.requestId %>" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    Manage Payment →
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-6 text-slate-400">No compensation records registered yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
