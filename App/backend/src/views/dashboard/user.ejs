<%# LRVS — User (Citizen) Dashboard | Team BLAZE | SIH26016 %>
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-[#1A2A42]">My Dashboard</h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Welcome back, <span class="font-semibold text-[#207E85]"><%= currentUser.name %></span> &middot;
        <span class="uppercase tracking-wide"><%= currentUser.userId %></span>
      </p>
    </div>
    <form action="/logout" method="POST">
      <button
        type="submit"
        class="px-4 py-2 text-xs font-semibold bg-white border border-[#E7EDEF] rounded-lg text-[#314155] hover:bg-rose-50 hover:border-rose-200 hover:text-rose-600 transition"
      >
        Sign Out
      </button>
    </form>
  </div>

  <!-- Info Card -->
  <div class="bg-white rounded-xl border border-[#E7EDEF] p-6 flex items-start gap-4">
    <div class="w-11 h-11 rounded-lg bg-[#207E85]/10 border border-[#207E85]/20 flex items-center justify-center text-[#207E85] flex-shrink-0">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </div>
    <div>
      <div class="font-bold text-[#1A2A42] text-sm"><%= currentUser.name %></div>
      <div class="text-xs text-slate-500 mt-0.5">Role: <span class="font-semibold uppercase"><%= currentUser.role %></span></div>
      <% if (currentUser.state) { %>
        <div class="text-xs text-slate-500">State: <%= currentUser.state %></div>
      <% } %>
      <% if (currentUser.district) { %>
        <div class="text-xs text-slate-500">District: <%= currentUser.district %></div>
      <% } %>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href="/land/requests"
       class="bg-white rounded-xl border border-[#E7EDEF] p-5 hover:border-[#207E85] hover:shadow-sm transition group">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-[#207E85]/10 flex items-center justify-center text-[#207E85]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#1A2A42] group-hover:text-[#207E85] transition">My Land Records</span>
      </div>
      <p class="text-xs text-slate-500">View the status of your land acquisition requests.</p>
    </a>

    <div class="bg-white rounded-xl border border-[#E7EDEF] p-5">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-[#207E85]/10 flex items-center justify-center text-[#207E85]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#1A2A42]">Secure Session</span>
      </div>
      <p class="text-xs text-slate-500">
        You are authenticated as a <strong>User</strong>. All actions are logged against your ID.
      </p>
    </div>
  </div>

</div>
