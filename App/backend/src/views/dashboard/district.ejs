<!-- ─── CHARTS & MAP INITIALIZATION SCRIPT ─────────────────────── -->
<script>
document.addEventListener('DOMContentLoaded', function() {

  // 1. Request Trend Multi-Line Chart (Nashik Scale 0-12)
  const trendCtx = document.getElementById('districtTrendChart');
  if (trendCtx) {
    new Chart(trendCtx.getContext('2d'), {
      type: 'line',
      data: {
        labels: ['01 Aug', '03 Aug', '05 Aug', '07 Aug', '09 Aug', '11 Aug', '13 Aug'],
        datasets: [
          {
            label: 'Approved',
            data: [4, 6, 5, 9, 8, 11, 10],
            borderColor: '#10B981',
            backgroundColor: 'rgba(16, 185, 129, 0.08)',
            fill: true,
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Pending',
            data: [2, 4, 3, 6, 5, 7, 6],
            borderColor: '#F59E0B',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Under Verification',
            data: [1, 3, 2, 4, 3, 5, 4],
            borderColor: '#3B82F6',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Rejected',
            data: [0, 1, 1, 2, 1, 2, 1],
            borderColor: '#EF4444',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 5
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index',
            intersect: false,
            backgroundColor: '#1A2A42',
            titleFont: { size: 11, weight: 'bold' },
            bodyFont: { size: 11 },
            padding: 8,
            cornerRadius: 6
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#94A3B8', font: { size: 10 } }
          },
          y: {
            min: 0,
            max: 12,
            ticks: { stepSize: 2, color: '#94A3B8', font: { size: 10 } },
            grid: { color: '#F1F5F9' }
          }
        }
      }
    });
  }

  // 2. Real Nashik District Boundary & Village GIS Map Initialization
  if (window.LRVS_GIS) {
    window.LRVS_GIS.initDistrictMap('districtNashikMap', '<%= typeof googleMapsApiKey !== "undefined" ? googleMapsApiKey : "" %>');
  }

  // 3. Land Acquisition by Status Donut Chart
  const donutCtx = document.getElementById('districtDonutChart');
  if (donutCtx) {
    new Chart(donutCtx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Pending', 'Under Verification', 'Approved', 'Rejected'],
        datasets: [{
          data: [8, 9, 14, 5],
          backgroundColor: ['#D97706', '#3B82F6', '#10B981', '#EF4444'],
          borderWidth: 3,
          borderColor: '#FFFFFF',
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '72%',
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1A2A42',
            padding: 8,
            cornerRadius: 6,
            callbacks: {
              label: function(context) {
                return ' ' + context.label + ': ' + context.parsed + ' requests';
              }
            }
          }
        }
      }
    });
  }

});
</script>
