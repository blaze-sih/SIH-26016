<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LRVS — Land Record Verification System</title>
<style>
  :root{
    --navy:#111c33;
    --navy-2:#0d1628;
    --teal:#1f8a86;
    --teal-dark:#186f6c;
    --bg-right:#eef2f2;
    --text-muted:#8a93a6;
    --border:#dfe4e4;
    --danger:#e0453f;
    --ink:#16233a;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink);
  }
  .wrap{
    display:flex;
    min-height:100vh;
  }
  /* LEFT PANEL */
  .left{
    flex:1 1 50%;
    background:var(--navy);
    color:#fff;
    padding:56px 64px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:14px;
    margin-bottom:56px;
  }
  .brand-icon{
    width:48px;height:48px;
    background:var(--teal);
    border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-size:22px;
  }
  .brand-title{font-weight:700;font-size:18px;line-height:1.2;}
  .brand-sub{font-size:13px;color:#a9b3c4;}

  .eyebrow{
    color:var(--teal);
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    margin-bottom:14px;
  }
  h1.headline{
    font-size:38px;
    line-height:1.18;
    font-weight:800;
    margin:0 0 20px 0;
    max-width:520px;
  }
  .lead{
    color:#c3cad9;
    font-size:15.5px;
    line-height:1.6;
    max-width:480px;
    margin-bottom:36px;
  }
  .features{display:flex;flex-direction:column;gap:22px;margin-bottom:40px;}
  .feature{display:flex;gap:14px;align-items:flex-start;}
  .feature-icon{
    width:38px;height:38px;flex:none;
    background:rgba(255,255,255,.08);
    border-radius:8px;
    display:flex;align-items:center;justify-content:center;
    font-size:16px;
  }
  .feature-title{font-weight:700;font-size:15px;margin-bottom:2px;}
  .feature-desc{color:#9aa4b8;font-size:13.5px;line-height:1.5;}
  .footer-note{color:#7b849a;font-size:13px;}

  /* RIGHT PANEL */
  .right{
    flex:1 1 50%;
    background:var(--bg-right);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px;
  }
  .card{width:100%;max-width:440px;}
  .card h2{font-size:26px;margin:0 0 6px 0;}
  .card .sub{color:#5b6577;font-size:14.5px;margin-bottom:28px;}

  label{
    display:block;
    font-size:14px;
    font-weight:600;
    margin-bottom:8px;
    color:var(--ink);
  }
  .req{color:var(--danger);}
  .field{margin-bottom:20px;}
  input[type="text"],input[type="password"]{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:8px;
    font-size:15px;
    background:#fff;
  }
  .pw-wrap{position:relative;}
  .pw-wrap button{
    position:absolute;right:10px;top:50%;transform:translateY(-50%);
    background:none;border:none;cursor:pointer;color:#8a93a6;
  }

  .row-between{
    display:flex;align-items:center;justify-content:space-between;
    margin:18px 0 20px 0;font-size:14px;
  }
  .remember{display:flex;align-items:center;gap:8px;color:#3d4658;}
  .forgot{color:var(--teal-dark);text-decoration:none;font-weight:600;}
  .forgot:hover{text-decoration:underline;}

  .btn-signin{
    width:100%;
    background:var(--teal);
    color:#fff;
    border:none;
    padding:14px;
    border-radius:8px;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
  }
  .btn-signin:hover{background:var(--teal-dark);}

  .error-banner{
    background:#fdecea;
    border:1px solid #f3b9b5;
    color:var(--danger);
    font-size:13.5px;
    padding:10px 14px;
    border-radius:8px;
    margin-bottom:18px;
  }

  @media (max-width:900px){
    .wrap{flex-direction:column;}
    .left,.right{padding:36px 28px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- LEFT PANEL -->
  <div class="left">
    <div>
      <div class="brand">
        <div class="brand-icon">🏛️</div>
        <div>
          <div class="brand-title">LRVS</div>
          <div class="brand-sub">Land Record Verification System</div>
        </div>
      </div>

      <div class="eyebrow">SIH 26016</div>
      <h1 class="headline">From an unverified document to a verified, traceable land record.</h1>
      <p class="lead">
        Ingest source documents, extract and normalise fields with AI, verify against the original,
        approve with accountability, and publish a tamper-evident record for citizens.
      </p>

      <div class="features">
        <div class="feature">
          <div class="feature-icon">📄</div>
          <div>
            <div class="feature-title">AI extraction &amp; translation</div>
            <div class="feature-desc">Marathi 7/12 extracts normalised into structured fields.</div>
          </div>
        </div>
        <div class="feature">
          <div class="feature-icon">🔎</div>
          <div>
            <div class="feature-title">Human verification</div>
            <div class="feature-desc">Every AI value is checked against the source document.</div>
          </div>
        </div>
        <div class="feature">
          <div class="feature-icon">🛡️</div>
          <div>
            <div class="feature-title">Hash-anchored audit trail</div>
            <div class="feature-desc">Each approved record is anchored with a SHA-256 digest.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-note">Revenue Department, Government of Maharashtra · Authorised use only.</div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right">
    <div class="card">
      <h2>Welcome back</h2>
      <div class="sub">Sign in to continue to your workspace</div>

      <% /* 'error' and 'userId' are optional locals a route can pass in, e.g.
            res.render('lrvs-login', { error: 'Invalid credentials', userId: 'MH-REV-4471' });
            Both fall back to safe defaults when not supplied. */ %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-banner"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="field">
          <label>User ID <span class="req">*</span></label>
          <input type="text" name="userId" value="<%= typeof userId !== 'undefined' ? userId : 'MH-REV-4471' %>" />
        </div>

        <div class="field">
          <label>Password <span class="req">*</span></label>
          <div class="pw-wrap">
            <input type="password" name="password" placeholder="" />
            <button type="button" aria-label="Toggle password visibility">👁</button>
          </div>
        </div>

        <div class="row-between">
          <label class="remember"><input type="checkbox" name="rememberMe" /> Remember me</label>
          <a href="/forgot-password" class="forgot">Forgot password?</a>
        </div>

        <button class="btn-signin" type="submit">Sign In</button>
      </form>

    </div>
  </div>

</div>
<script>
  // Simple password show/hide toggle (client-side only)
  document.querySelector('.pw-wrap button').addEventListener('click', function () {
    const input = this.previousElementSibling;
    input.type = input.type === 'password' ? 'text' : 'password';
  });
</script>
</body>
</html>
