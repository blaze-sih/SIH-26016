<!-- GIS / Cadastral Land Map (Ref: Section 12) -->
<div class="space-y-5">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-[#1A2A42]">GIS Cadastral Land Map</h1>
      <p class="text-xs text-slate-500 mt-0.5">Geographic visualization of land parcels, corridor alignments, and acquisition status across districts.</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#E8F3F4] text-[#207E85] border border-[#C5E1E3]">
        <%= (parcels && parcels.length) || 0 %> Geotagged Parcels
      </span>
    </div>
  </div>

  <!-- Map Canvas & Detail Panel Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

    <!-- Leaflet Map Container (8 cols) -->
    <div class="lg:col-span-8 lrvs-card p-4 bg-white space-y-3">
      <div id="map" class="w-full h-[580px] rounded-lg border border-[#E7EDEF] relative bg-[#F3F8F9]">
        <!-- Fallback banner if tiles are completely blocked -->
        <div id="map-notice" class="hidden absolute top-3 left-14 z-[400] bg-white/90 backdrop-blur-sm border border-[#E7EDEF] px-3 py-1.5 rounded-lg text-[11px] text-slate-600 shadow-sm flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#207E85]"></span>
          <span>Cadastral Cadastre Mode · Vector Land Parcels</span>
        </div>
      </div>
      
      <!-- Legend (Ref: Section 12) -->
      <div class="flex items-center gap-4 text-xs font-medium text-slate-600 pt-1 flex-wrap">
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#207E85]"></span> Approved / Possessed</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#2563EB]"></span> In Approval Pipeline</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#D97706]"></span> Pending Verification</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Submitted / Draft</span>
      </div>
    </div>

    <!-- Selected Parcel Inspector Sidebar (4 cols) -->
    <div id="parcel-inspector" class="lg:col-span-4 lrvs-card p-5 bg-white space-y-4">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 pb-2 border-b border-[#E7EDEF]">
          Cadastral Parcel Inspector
        </h2>
        <p class="text-[11px] text-slate-400 mt-0.5">Click any parcel marker on the map to inspect ownership and survey details.</p>
      </div>

      <div id="inspector-placeholder" class="py-12 text-center text-slate-400 text-xs space-y-2">
        <div class="w-10 h-10 rounded-full bg-[#E8F3F4] text-[#207E85] flex items-center justify-center mx-auto">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
        </div>
        <p class="font-medium text-slate-600">No parcel selected</p>
        <p class="text-[11px]">Select a cadastral point on the map to view verification record</p>
      </div>

      <div id="inspector-content" class="hidden space-y-3.5 text-xs">
        <div>
          <span class="text-slate-400 block text-[10px]">Request Identifier</span>
          <div id="insp-req-id" class="text-sm font-bold font-mono text-[#207E85] mt-0.5"></div>
          <div id="insp-status" class="mt-1"></div>
        </div>

        <div>
          <span class="text-slate-400 block text-[10px]">Project Name</span>
          <div id="insp-project" class="font-bold text-[#1A2A42] mt-0.5"></div>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[#E7EDEF]">
          <div>
            <span class="text-slate-400 block text-[10px]">Survey Number</span>
            <div id="insp-survey" class="font-mono font-bold text-[#1A2A42]"></div>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px]">Village</span>
            <div id="insp-village" class="font-semibold text-slate-700"></div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <span class="text-slate-400 block text-[10px]">District</span>
            <div id="insp-district" class="font-semibold text-slate-700"></div>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px]">Total Area</span>
            <div id="insp-area" class="font-semibold text-slate-700"></div>
          </div>
        </div>

        <div class="pt-3 border-t border-[#E7EDEF]">
          <a id="insp-link" href="#" class="btn-teal w-full block py-2.5 px-4 text-center text-xs font-semibold rounded-lg shadow-sm">
            Open Land Record →
          </a>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- Initialize Leaflet GIS with Robust Tile Fallback -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const parcels = <%- JSON.stringify(parcels || []) %>;

  // Center on Maharashtra / Pune
  const defaultLat = 18.5204;
  const defaultLng = 73.8567;

  const map = L.map('map', {
    zoomControl: true,
    attributionControl: false
  }).setView([defaultLat, defaultLng], 9);

  // Use CartoDB Positron / Voyager clean vector tiles
  const primaryTileUrl = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
  const tileLayer = L.tileLayer(primaryTileUrl, {
    maxZoom: 19,
    subdomains: 'abcd',
  }).addTo(map);

  // Intercept any tile loading error (e.g. 403 or network failure)
  // Replaces error tile with clean subtle SVG cadastral grid so 403 error images NEVER render!
  tileLayer.on('tileerror', function(error) {
    document.getElementById('map-notice').classList.remove('hidden');
    if (error.tile) {
      error.tile.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" fill="%23F3F8F9"><rect width="256" height="256"/><path d="M0 0h256v256H0z" fill="none" stroke="%23E7EDEF" stroke-width="1"/></svg>';
    }
  });

  const markers = [];

  parcels.forEach((p, index) => {
    let lat = p.location?.latitude;
    let lng = p.location?.longitude;

    if (!lat || !lng) {
      // Deterministic offset based on index for consistent demo plotting
      lat = 18.5204 + (Math.sin(index + 1) * 0.15);
      lng = 73.8567 + (Math.cos(index + 1) * 0.15);
    }

    const st = (p.acquisitionStatus || p.status || 'SUBMITTED').toUpperCase();
    let markerColor = '#94a3b8';
    if (['APPROVED', 'COMPENSATION_PAID', 'POSSESSION_COMPLETED'].includes(st)) markerColor = '#207E85';
    else if (['PENDING_APPROVAL'].includes(st)) markerColor = '#2563EB';
    else if (['PENDING_VERIFICATION', 'AI_PROCESSED'].includes(st)) markerColor = '#D97706';

    const circleMarker = L.circleMarker([lat, lng], {
      radius: 9,
      fillColor: markerColor,
      color: '#ffffff',
      weight: 2,
      opacity: 1,
      fillOpacity: 0.9
    }).addTo(map);

    circleMarker.bindPopup(`
      <div style="font-family: -apple-system, sans-serif; font-size: 11px; line-height: 1.4; color: #1A2A42;">
        <strong style="color: #207E85;">${p.requestId}</strong><br/>
        Survey No: <b>${p.surveyNumber || '118/2A'}</b><br/>
        Village: ${p.village || 'Deolali'}, ${p.district || 'Nashik'}<br/>
        Status: <span style="font-weight: 700; color: ${markerColor};">${st.replace(/_/g, ' ')}</span><br/>
        <a href="/land/${p.requestId}" style="color: #207E85; font-weight: 600; text-decoration: underline; display: inline-block; margin-top: 4px;">View Record →</a>
      </div>
    `);

    circleMarker.on('click', () => {
      document.getElementById('inspector-placeholder').classList.add('hidden');
      document.getElementById('inspector-content').classList.remove('hidden');

      document.getElementById('insp-req-id').innerText = p.requestId;
      document.getElementById('insp-status').innerHTML = `<span class="badge-status badge-${st.toLowerCase()}">${st.replace(/_/g, ' ')}</span>`;
      document.getElementById('insp-project').innerText = p.projectName || 'Infrastructure Project';
      document.getElementById('insp-survey').innerText = p.surveyNumber || '118/2A';
      document.getElementById('insp-village').innerText = p.village || 'Deolali';
      document.getElementById('insp-district').innerText = `${p.district || 'Nashik'}, ${p.state || 'Maharashtra'}`;
      document.getElementById('insp-area').innerText = `${p.area?.total || '1.82'} ${p.area?.unit || 'Hectare'}`;
      document.getElementById('insp-link').href = `/land/${p.requestId}`;
    });

    markers.push(circleMarker);
  });

  if (markers.length > 0) {
    const group = new L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.2));
  }
});
</script>
