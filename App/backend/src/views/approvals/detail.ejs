            <span class="text-slate-400 block text-[10px]">Owner</span>
            <span class="font-bold text-[#1A2A42] mt-0.5 block"><%= ownerName %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px]">Survey Number</span>
            <span class="font-mono font-bold text-[#1A2A42] mt-0.5 block"><%= survey %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px]">Area</span>
            <span class="font-bold text-[#1A2A42] mt-0.5 block"><%= area %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px]">District</span>
