<div class="min-h-[60vh] flex flex-col items-center justify-center text-center p-6 space-y-4">
  <div class="w-16 h-16 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 font-bold text-xl border border-amber-200">
    500
  </div>
  <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Internal System Error</h1>
  <p class="text-sm text-slate-500 max-w-md">
    <%= typeof message !== 'undefined' ? message : 'An unexpected condition was encountered on the server. The incident has been recorded in the audit log.' %>
  </p>
  <div class="pt-2 flex gap-3">
    <a href="/dashboard" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
      Return to Dashboard
    </a>
  </div>
</div>
