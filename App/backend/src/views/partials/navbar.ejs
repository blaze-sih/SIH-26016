<%
  /* ─── Helpers ─────────────────────────────────────────────────── */
  const _role     = (currentUser && currentUser.role) ? currentUser.role : 'USER';
  const _name     = (currentUser && currentUser.name) ? currentUser.name : 'User';
  const _userId   = (currentUser && (currentUser.userId || currentUser._id)) ? (currentUser.userId || currentUser._id) : '';

  /* Initials matching reference screenshots */
  let _initials = 'US';
  if (_role === 'CENTRAL_AUTHORITY') {
    _initials = 'AD';
  } else if (_role === 'STATE_AUTHORITY') {
    _initials = 'SG';
  } else if (_role === 'DISTRICT_AUTHORITY') {
    _initials = 'DN';
  } else if (_name) {
    _initials = _name.split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2);
  }

  /* Current path */
  const _cur = typeof currentPath !== 'undefined' ? currentPath : (typeof current !== 'undefined' ? current : (locals.current || '/'));

  /* Search placeholder */
  let _searchPlaceholder = 'Search request ID, project name...';
  if (_role === 'CENTRAL_AUTHORITY') {
    _searchPlaceholder = 'Search request ID, project name, state or district...';
  } else if (_role === 'STATE_AUTHORITY') {
    _searchPlaceholder = 'Search by request ID, project name, district or village...';
  } else if (_role === 'DISTRICT_AUTHORITY') {
    _searchPlaceholder = 'Search by request ID, project name, village or survey no...';
  }
%>

<header class="sticky top-0 z-30 bg-white border-b border-[#E7EDEF] h-16 flex items-center justify-between px-4 sm:px-6 shadow-sm">

  <!-- ── Left: Breadcrumb ──────────────────────────────────────── -->
  <div class="flex items-center gap-3 min-w-0">
    <!-- Hamburger for mobile -->
    <button
      id="sidebarToggleBtn"
      class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 transition-colors"
      aria-label="Toggle sidebar"
      onclick="document.getElementById('mainSidebar')?.classList.toggle('-translate-x-full')"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Breadcrumb items matching reference -->
    <nav class="flex items-center gap-1.5 text-xs sm:text-sm font-medium min-w-0">
      <% if (_role === 'CENTRAL_AUTHORITY') { %>
        <span class="text-slate-400">Central Ministry</span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-[#1A2A42] font-semibold">Dashboard</span>
      <% } else if (_role === 'STATE_AUTHORITY') { %>
        <span class="text-slate-400">State Government</span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-[#1A2A42] font-semibold">Dashboard</span>
      <% } else if (_role === 'DISTRICT_AUTHORITY') { %>
        <span class="text-slate-400">District Authority</span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-slate-400"><%= (currentUser && currentUser.district) ? currentUser.district : 'Nashik' %></span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-[#1A2A42] font-semibold">Dashboard</span>
      <% } else if (_role === 'LAND_OWNER') { %>
        <span class="text-slate-400">Land Owner</span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-[#1A2A42] font-semibold">Dashboard</span>
      <% } else { %>
        <span class="text-slate-400">LRVS</span>
        <span class="text-slate-300 font-semibold mx-0.5">&gt;</span>
        <span class="text-[#1A2A42] font-semibold"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></span>
      <% } %>
    </nav>
  </div>

  <!-- ── Right: Controls matching Screenshot Order ──────────────── -->
  <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">

    <!-- 1. Search Box -->
    <div class="relative hidden md:block">
      <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35"/>
        </svg>
      </div>
      <input
        type="text"
        placeholder="<%= _searchPlaceholder %>"
        class="w-64 lg:w-80 pl-9 pr-4 py-2 text-xs bg-white border border-[#E7EDEF] rounded-lg text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#207E85] focus:border-[#207E85] transition-all shadow-sm"
      />
    </div>

    <!-- 2. Notification Bell with Red Dot -->
    <div class="relative" id="navNotifWrapper">
      <button
        id="navNotifBtn"
        onclick="document.getElementById('navNotifDropdown').classList.toggle('hidden')"
        class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 transition-colors relative"
        aria-label="Notifications"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <!-- Red dot indicator -->
        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full ring-2 ring-white"></span>
      </button>

      <!-- Notification Dropdown -->
      <div id="navNotifDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white border border-[#E7EDEF] rounded-xl shadow-xl z-50 overflow-hidden">
        <div class="px-4 py-3 border-b border-[#E7EDEF] flex items-center justify-between bg-[#F8FAFB]">
          <span class="text-xs font-bold text-[#1A2A42] uppercase tracking-wide">Notifications</span>
          <span class="text-[11px] text-[#207E85] font-semibold cursor-pointer hover:underline">Mark all read</span>
        </div>
        <div class="divide-y divide-[#F1F5F7] max-h-64 overflow-y-auto">
          <div class="px-4 py-3 hover:bg-[#F8FAFB] transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-[#207E85] mt-1.5 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-slate-800 font-semibold">New acquisition proposal submitted</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Greenfield Expressway, Nashik · 12 Aug 2026</p>
              </div>
            </div>
          </div>
          <div class="px-4 py-3 hover:bg-[#F8FAFB] transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-amber-400 mt-1.5 flex-shrink-0"></div>
              <div>
                <p class="text-xs text-slate-800 font-semibold">Verification review pending</p>
                <p class="text-[11px] text-slate-500 mt-0.5">LA-2026-0158 · Nashik District</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. User Avatar Circle + Dropdown (AD / SG / DN) -->
    <div class="relative" id="navUserWrapper">
      <button
        id="navUserBtn"
        onclick="document.getElementById('navUserDropdown').classList.toggle('hidden')"
        class="flex items-center gap-1.5 p-1 rounded-lg hover:bg-slate-100 transition-colors group"
        aria-label="User menu"
      >
        <div class="w-8 h-8 rounded-full bg-[#207E85] flex items-center justify-center text-white text-xs font-bold shadow-sm flex-shrink-0">
          <%= _initials %>
        </div>
        <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-700 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <!-- User Dropdown with /logout Form -->
      <div id="navUserDropdown" class="hidden absolute right-0 mt-2 w-64 bg-white border border-[#E7EDEF] rounded-xl shadow-xl z-50 overflow-hidden">
        <div class="px-4 py-3 border-b border-[#E7EDEF] bg-[#F8FAFB]">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-[#207E85] flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
              <%= _initials %>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-[#1A2A42] truncate"><%= _name %></div>
              <div class="text-[11px] text-slate-500 font-mono truncate"><%= _userId %></div>
              <div class="text-[10px] text-[#207E85] font-semibold truncate mt-0.5"><%= _role %></div>
            </div>
          </div>
        </div>
        <div class="py-1">
          <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-xs text-slate-700 hover:bg-[#F3F8F9] hover:text-[#207E85] transition-colors">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Profile & Settings
          </a>
        </div>
        <div class="border-t border-[#E7EDEF] py-1 bg-[#FAFCFD]">
          <form action="/logout" method="POST" id="navbarLogoutForm">
            <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition-colors text-left">
              <svg class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Logout
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- 4. Date Card matching Reference Screenshot at Far Right -->
    <div class="flex items-center gap-2 px-3 py-1.5 bg-white border border-[#E7EDEF] rounded-lg shadow-sm text-right select-none">
      <svg class="w-4 h-4 text-[#1A2A42] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <div class="text-right leading-tight">
        <div id="navDateDay" class="text-xs font-bold text-[#1A2A42]">12 Aug 2026</div>
        <div id="navDateWeekday" class="text-[10px] text-slate-400 font-medium">Wednesday</div>
      </div>
    </div>

  </div>

</header>

<!-- Script for Dropdown toggles and date display -->
<script>
(function() {
  // Format current date nicely
  try {
    const now = new Date();
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    const dayEl = document.getElementById('navDateDay');
    const weekdayEl = document.getElementById('navDateWeekday');
    if (dayEl && weekdayEl) {
      dayEl.textContent = now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
      weekdayEl.textContent = days[now.getDay()];
    }
  } catch (e) {}

  // Close dropdowns on outside click
  document.addEventListener('click', function(e) {
    const notifWrapper = document.getElementById('navNotifWrapper');
    const notifDropdown = document.getElementById('navNotifDropdown');
    if (notifWrapper && notifDropdown && !notifWrapper.contains(e.target)) {
      notifDropdown.classList.add('hidden');
    }
    const userWrapper = document.getElementById('navUserWrapper');
    const userDropdown = document.getElementById('navUserDropdown');
    if (userWrapper && userDropdown && !userWrapper.contains(e.target)) {
      userDropdown.classList.add('hidden');
    }
  });
})();
</script>
