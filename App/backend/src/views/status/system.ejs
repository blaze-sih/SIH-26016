<!-- System Status & Diagnostics (LRVS Design) -->
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#E7EDEF]">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-[#1A2A42]">System Status & Architecture Diagnostics</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#207E85]/10 text-[#207E85] border border-[#207E85]/20">
          Live Monitor
        </span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Live health monitor of LRVS microservices, database cluster, and AI pipeline</p>
    </div>
    <div>
      <span class="text-xs font-mono text-slate-500 bg-white px-3 py-1.5 rounded-lg border border-[#E7EDEF] shadow-sm">
        Checked: <%= new Date(status.timestamp || Date.now()).toLocaleTimeString('en-IN') %>
      </span>
    </div>
  </div>

  <!-- Status Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Backend -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Core Backend</span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
      </div>
      <div class="text-xl font-bold text-[#1A2A42]">Node.js Express</div>
      <div class="text-xs text-slate-500 flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded font-semibold text-[11px] bg-emerald-100 text-emerald-800">
          <%= status.backend || 'UP' %>
        </span>
        <span>Port 9000</span>
      </div>
    </div>

    <!-- Database -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Database</span>
        <span class="w-3 h-3 rounded-full <%= status.database === 'UP' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
      </div>
      <div class="text-xl font-bold text-[#1A2A42]">MongoDB</div>
      <div class="text-xs text-slate-500 flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded font-semibold text-[11px] <%= status.database === 'UP' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
          <%= status.database || 'DOWN' %>
        </span>
        <span>Replica / Standalone</span>
      </div>
    </div>

    <!-- AI Service -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">AI Service</span>
        <span class="w-3 h-3 rounded-full <%= status.aiService === 'UP' ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
      </div>
      <div class="text-xl font-bold text-[#1A2A42]">Qwen2.5-VL / Python</div>
      <div class="text-xs text-slate-500 flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded font-semibold text-[11px] <%= status.aiService === 'UP' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
          <%= status.aiService || 'STANDBY' %>
        </span>
        <span>Port 8000</span>
      </div>
    </div>

    <!-- Security Anchor -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Security Anchor</span>
        <span class="w-3 h-3 rounded-full bg-[#207E85]"></span>
      </div>
      <div class="text-xl font-bold text-[#1A2A42]">EVM Smart Contracts</div>
      <div class="text-xs text-slate-500 flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded font-semibold text-[11px] bg-[#207E85]/10 text-[#207E85] border border-[#207E85]/20">
          <%= status.blockchain || 'ACTIVE' %>
        </span>
        <span>Polygon / Hardhat</span>
      </div>
    </div>

  </div>

  <!-- Architecture Overview Card -->
  <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
    <h2 class="text-base font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">SIH-26016 Architectural Layering</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-lg bg-slate-50 border border-[#E7EDEF] space-y-1.5">
        <div class="font-bold text-[#1A2A42]">Layer 1: Presentation & EJS</div>
        <p class="text-slate-600">Tailwind CSS, Leaflet GIS, Chart.js, HTTP-only secure cookie authentication, role-based dashboards.</p>
      </div>
      <div class="p-4 rounded-lg bg-slate-50 border border-[#E7EDEF] space-y-1.5">
        <div class="font-bold text-[#1A2A42]">Layer 2: Core Engine & Workflow</div>
        <p class="text-slate-600">Express.js REST APIs, MongoDB data layer, Joi schema validation, multi-level district-state-central approvals.</p>
      </div>
      <div class="p-4 rounded-lg bg-slate-50 border border-[#E7EDEF] space-y-1.5">
        <div class="font-bold text-[#1A2A42]">Layer 3: Trust & AI Verification</div>
        <p class="text-slate-600">FastAPI OCR document ingestion, cryptographic SHA-256 state hashing, immutable EVM blockchain anchoring.</p>
      </div>
    </div>
  </div>

</div>
