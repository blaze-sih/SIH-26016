          <!-- Village -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Village <span class="text-red-500">*</span>
            </label>
            <input type="text" id="editVillage" required value="Sinnar"
                   class="w-full px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-[#207E85]/20 focus:border-[#207E85]">
          </div>

          <!-- District -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              District <span class="text-red-500">*</span>
            </label>
            <input type="text" id="editDistrict" required value="Nashik"
                   class="w-full px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-[#207E85]/20 focus:border-[#207E85]">
          </div>

          <!-- Land Area & Unit -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Land Area <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-12 gap-2">
              <input type="number" step="0.01" id="editLandArea" required value="45.2"
                     class="col-span-8 px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-[#207E85]/20 focus:border-[#207E85]">
              <select id="editAreaUnit" class="col-span-4 px-3 py-2.5 text-xs bg-white border border-slate-300 rounded-xl text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-[#207E85]/20 focus:border-[#207E85]">
                <option value="Hectare" selected>Ha</option>
                <option value="Acre">Acre</option>
                <option value="SqMeters">Sq.m</option>
              </select>
            </div>
          </div>

          <!-- Save & Submit Button matching Image 2 Screen 3 -->
          <div class="pt-2">
            <button type="submit" id="btnSaveSubmit" class="w-full py-3 bg-[#207E85] hover:bg-[#19656b] text-white font-bold text-xs rounded-xl shadow-md transition-colors flex items-center justify-center gap-2">
              <span id="btnSaveText">Save &amp; Submit</span>
              <svg id="saveSpinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

        </form>

      </div>

    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- CLIENT SCRIPTS — GIS Map, Dynamic Modals, AI Correction Workflow           -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<script>
  let parcelMapInstance = null;
  let parcelPolygonLayer = null;
  let docCurrentZoom = 1.0;

  // Initialize interactive GIS satellite map
  document.addEventListener('DOMContentLoaded', () => {
    initParcelMap();
  });

  function initParcelMap() {
    const mapEl = document.getElementById('parcelMap');
    if (!mapEl || parcelMapInstance) return;

    // Sinnar, Nashik Coordinates: 19.8510° N, 74.0010° E
    const centerLat = 19.8510;
    const centerLng = 74.0010;

    parcelMapInstance = L.map('parcelMap', {
      center: [centerLat, centerLng],
      zoom: 16,
      zoomControl: true,
      attributionControl: false
    });

    // Satellite Imagery Layer (Esri World Imagery)
    const esriSat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 19,
      attribution: 'Esri World Imagery'
    });

    // OpenStreetMap Fallback Layer
    const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19
    });

    esriSat.addTo(parcelMapInstance);

    // Parcel Boundary Polygon matching Screenshot 1
    // Polygon styled with emerald/cyan glowing border & semi-transparent fill
    const parcelCoords = [
      [19.8525, 73.9985],
      [19.8540, 74.0005],
      [19.8528, 74.0035],
      [19.8495, 74.0030],
      [19.8490, 73.9995]
    ];

    parcelPolygonLayer = L.polygon(parcelCoords, {
      color: '#00e676',
      weight: 3.5,
      opacity: 0.95,
      fillColor: '#00e676',
      fillOpacity: 0.22,
      dashArray: '2, 4'
    }).addTo(parcelMapInstance);

    // Custom Marker Label at Center matching Image 1
    const centerIcon = L.divIcon({
      className: 'custom-parcel-pin',
      html: `
        <div style="background: white; border: 2px solid #207E85; border-radius: 8px; padding: 4px 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2); text-align: center; min-width: 110px;">
          <div style="font-size: 11px; font-weight: 800; color: #1e293b; font-family: monospace;">Survey No. <span id="pinSurveyNo">142/3</span></div>
          <div style="font-size: 10px; font-weight: 600; color: #64748b;">Area: 45.2 Ha</div>
        </div>
      `,
      iconSize: [120, 42],
      iconAnchor: [60, 21]
    });

    L.marker([19.8512, 74.0010], { icon: centerIcon }).addTo(parcelMapInstance);

    // Fit map bounds to parcel polygon with padding
    parcelMapInstance.fitBounds(parcelPolygonLayer.getBounds(), { padding: [50, 50] });
  }

  function zoomToParcel() {
    if (parcelMapInstance && parcelPolygonLayer) {
      parcelMapInstance.fitBounds(parcelPolygonLayer.getBounds(), { padding: [60, 60], animate: true });
    }
  }

  // ── Modal Interactions ───────────────────────────────────────────────────────
  function openUploadModal() {
    document.getElementById('uploadModal').classList.remove('hidden');
  }

  function closeUploadModal() {
    document.getElementById('uploadModal').classList.add('hidden');
    document.getElementById('uploadDocForm').reset();
    document.getElementById('selectedFileName').classList.add('hidden');
    document.getElementById('fileUploadPrompt').innerText = 'Tap to upload';
  }

  function handleFileSelected(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const fnEl = document.getElementById('selectedFileName');
      fnEl.innerText = `${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
      fnEl.classList.remove('hidden');
      document.getElementById('fileUploadPrompt').innerText = 'File selected';
    }
  }

  // Upload document via decoupled REST API (POST /api/documents)
  async function handleDocumentUpload(e) {
    e.preventDefault();
    const btnText = document.getElementById('btnUploadText');
    const spinner = document.getElementById('uploadSpinner');
    const submitBtn = document.getElementById('btnUploadSubmit');
    const fileInput = document.getElementById('docFileInput');

    if (!fileInput.files || !fileInput.files[0]) {
      alert('Please select a file to upload.');
      return;
    }

    try {
      submitBtn.disabled = true;
      btnText.innerText = 'AI Extracting...';
      spinner.classList.remove('hidden');

      const formData = new FormData();
      formData.append('document', fileInput.files[0]);
      formData.append('documentType', document.getElementById('uploadDocType').value);
      formData.append('autoProcessAI', 'true');
      formData.append('landParcelId', 'PARCEL-142-3');
      formData.append('acquisitionRequestId', 'LA-2026-0245');

      const res = await fetch('/api/documents', {
        method: 'POST',
        body: formData
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.message || 'Upload failed');
      }

      closeUploadModal();
      
      // Auto-open review modal for newly uploaded document
      const uploadedDoc = data.data.document;
      openReviewModal(uploadedDoc.documentId, uploadedDoc.documentType, uploadedDoc.documentName || 'Uploaded Document');
    } catch (err) {
      alert(`Upload error: ${err.message}`);
    } finally {
      submitBtn.disabled = false;
      btnText.innerText = 'Upload & Process';
      spinner.classList.add('hidden');
    }
  }

  // ── Review Modal Interactions ────────────────────────────────────────────────
  async function openReviewModal(docId, docType, docName) {
    document.getElementById('editDocId').value = docId;
    document.getElementById('reviewDocMeta').innerText = `${docId} · ${docName || docType}`;
    document.getElementById('previewDocTitle').innerText = `${docType.toLowerCase()}.pdf`;
    document.getElementById('btnDocDownloadLink').href = `/api/documents/${docId}/file`;

    // Fetch extraction fields via REST API
    try {
      const res = await fetch(`/api/documents/${docId}/extraction`);
      if (res.ok) {
        const payload = await res.json();
        const ext = payload.data && payload.data.extraction;
        if (ext && ext.fields) {
          if (ext.fields.ownerName) document.getElementById('editOwnerName').value = ext.fields.ownerName.value;
          if (ext.fields.surveyNumber) {
            document.getElementById('editSurveyNumber').value = ext.fields.surveyNumber.value;
            // If low confidence or suggestion exists, highlight alert
            if (ext.fields.surveyNumber.isLowConfidence || ext.fields.surveyNumber.suggestedCorrection) {
              document.getElementById('surveyAlertHint').classList.remove('hidden');
            } else {
              document.getElementById('surveyAlertHint').classList.add('hidden');
            }
          }
          if (ext.fields.village) document.getElementById('editVillage').value = ext.fields.village.value;
          if (ext.fields.district) document.getElementById('editDistrict').value = ext.fields.district.value;
          if (ext.fields.landArea) document.getElementById('editLandArea').value = ext.fields.landArea.value;
        }
      }
    } catch (err) {
      console.warn('Could not fetch latest extraction from server:', err);
    }

    switchReviewTab('extracted');
    document.getElementById('reviewModal').classList.remove('hidden');
  }

  function closeReviewModal() {
    document.getElementById('reviewModal').classList.add('hidden');
  }

  function switchReviewTab(tab) {
    const btnOrig = document.getElementById('tabBtnOriginal');
    const btnExtr = document.getElementById('tabBtnExtracted');
    const contentOrig = document.getElementById('tabOriginalContent');
    const contentExtr = document.getElementById('tabExtractedContent');

    if (tab === 'original') {
      btnOrig.className = 'py-3 px-4 text-xs font-bold text-[#207E85] border-b-2 border-[#207E85] transition-colors flex items-center gap-1.5';
      btnExtr.className = 'py-3 px-4 text-xs font-bold text-slate-500 border-b-2 border-transparent hover:text-slate-700 transition-colors flex items-center gap-1.5';
      contentOrig.classList.remove('hidden');
      contentExtr.classList.add('hidden');
    } else {
      btnExtr.className = 'py-3 px-4 text-xs font-bold text-[#207E85] border-b-2 border-[#207E85] transition-colors flex items-center gap-1.5';
      btnOrig.className = 'py-3 px-4 text-xs font-bold text-slate-500 border-b-2 border-transparent hover:text-slate-700 transition-colors flex items-center gap-1.5';
      contentExtr.classList.remove('hidden');
      contentOrig.classList.add('hidden');
    }
  }

  function adjustDocZoom(delta) {
    docCurrentZoom = Math.max(0.6, Math.min(2.0, docCurrentZoom + delta));
    const wrapper = document.getElementById('docViewerWrapper');
    if (wrapper) {
      wrapper.style.transform = `scale(${docCurrentZoom})`;
    }
  }

  function applySuggestedCorrection(val) {
    const input = document.getElementById('editSurveyNumber');
    input.value = val;
    input.classList.remove('border-red-300');
    input.classList.add('border-emerald-500', 'bg-emerald-50/50');
  }

  // Submit User Correction and Finalize Verification
  async function handleCorrectionSubmit(e) {
    e.preventDefault();
    const docId = document.getElementById('editDocId').value;
    const correctedSurveyNumber = document.getElementById('editSurveyNumber').value;
    const village = document.getElementById('editVillage').value;
    const district = document.getElementById('editDistrict').value;
    const landArea = document.getElementById('editLandArea').value;

    const btnText = document.getElementById('btnSaveText');
    const spinner = document.getElementById('saveSpinner');
    const submitBtn = document.getElementById('btnSaveSubmit');

    try {
      submitBtn.disabled = true;
      btnText.innerText = 'Submitting & Verifying...';
      spinner.classList.remove('hidden');

      // 1. Submit Correction to immutable collection
      const corrRes = await fetch(`/api/documents/${docId}/corrections`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          field: 'surveyNumber',
          correctedValue: correctedSurveyNumber,
          reason: 'Corrected from original 7/12 extract ground record'
        })
      });

      if (!corrRes.ok) {
        const errData = await corrRes.json();
        console.warn('Correction submission notice:', errData);
      }

      // 2. Finalize verification on document
      const verifyRes = await fetch(`/api/documents/${docId}/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          remarks: 'Land Owner reviewed and verified with Ground Survey Record',
          overrideFields: {
            surveyNumber: correctedSurveyNumber,
            village,
            district,
            landArea: parseFloat(landArea)
          }
        })
      });

      // 3. Update UI synchronously
      document.getElementById('cardSurveyNumber').innerText = correctedSurveyNumber;
      document.getElementById('mapSurveyNoText').innerText = correctedSurveyNumber;
      document.getElementById('cardVillage').innerText = village;
      document.getElementById('cardDistrict').innerText = district;
      document.getElementById('cardLandArea').innerText = `${landArea} Ha`;
      const pinLabel = document.getElementById('pinSurveyNo');
      if (pinLabel) pinLabel.innerText = correctedSurveyNumber;

      closeReviewModal();
      alert(`Success! Survey Number updated to ${correctedSurveyNumber} and verified in official land registry.`);
      window.location.reload();
    } catch (err) {
      alert(`Error submitting correction: ${err.message}`);
    } finally {
      submitBtn.disabled = false;
      btnText.innerText = 'Save & Submit';
      spinner.classList.add('hidden');
    }
  }
</script>
