# =============================================================
# LRVS Backend — Environment Variables Template
# Team BLAZE | SIH26016
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# =============================================================

# --- Server ---
PORT=9000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/sih26016

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# --- Google Maps / GIS ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# --- Blockchain ---
# Set BLOCKCHAIN_MOCK=true to skip real on-chain calls during development
BLOCKCHAIN_MOCK=true
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS_LAND=
BLOCKCHAIN_CONTRACT_ADDRESS_APPROVAL=
BLOCKCHAIN_CONTRACT_ADDRESS_COMPENSATION=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=localhost

# --- Storage ---
UPLOAD_DIR=uploads
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=storage/documents
MAX_FILE_SIZE_MB=20

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info
