          </div>
        </div>

        <div class="pt-2 border-t border-[#E7EDEF] flex items-center gap-2 text-[11px] text-slate-500">
          <svg class="w-3.5 h-3.5 text-[#207E85]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          <span>2 AI value(s) corrected during checking · Village Deolali</span>
        </div>
      </div>

      <!-- Card 2: Verification Checklist (Ref: PDF Page 10) -->
      <div class="lrvs-card p-5 bg-white space-y-4">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Verification Checklist</h2>
          <p class="text-[11px] text-slate-400 mt-0.5">Confirm each item before recording a decision.</p>
        </div>

        <div class="space-y-2 text-xs">
          <!-- Item 1 -->
          <div class="p-3 rounded-lg border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span class="font-medium text-[#1A2A42]">Identity and ownership fields match</span>
            </div>
            <span class="text-[11px] font-semibold text-[#207E85] flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#207E85]"></span> Verified
            </span>
          </div>

          <!-- Item 2 -->
          <div class="p-3 rounded-lg border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span class="font-medium text-[#1A2A42]">Document number and survey number match</span>
            </div>
            <span class="text-[11px] font-semibold text-[#207E85] flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#207E85]"></span> Verified
            </span>
          </div>

          <!-- Item 3 -->
          <div class="p-3 rounded-lg border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span class="font-medium text-[#1A2A42]">AI corrections reviewed by checker</span>
            </div>
            <span class="text-[11px] font-semibold text-[#207E85] flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#207E85]"></span> Verified
            </span>
          </div>

          <!-- Item 4 -->
          <div class="p-3 rounded-lg border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span class="font-medium text-[#1A2A42]">No duplicate record detected</span>
            </div>
            <span class="text-[11px] font-semibold text-[#207E85] flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#207E85]"></span> Verified
            </span>
          </div>
        </div>
      </div>

      <!-- Card 3: Source document collapsible viewer (Ref: PDF Page 11) -->
      <div class="lrvs-card overflow-hidden bg-white">
        <div class="p-4 flex items-center justify-between cursor-pointer bg-white hover:bg-[#F8FAFB]"
             onclick="document.getElementById('sourceDocAccordion').classList.toggle('hidden')">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#207E85]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <h2 class="text-xs font-bold text-[#1A2A42]">Source document</h2>
          </div>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>

        <div id="sourceDocAccordion" class="border-t border-[#E7EDEF]">
          <!-- Document bar -->
          <div class="px-4 py-2 bg-[#F8FAFB] border-b border-[#E7EDEF] flex items-center justify-between text-xs text-slate-600">
            <span class="font-mono text-[11px]">7-12-extract-118-2A.pdf</span>
            <div class="flex items-center gap-2">
              <button class="p-1 rounded hover:bg-slate-200">🔍 100%</button>
              <span>‹ 1 / 3 ›</span>
            </div>
          </div>
          <!-- Document display -->
          <div class="p-4 bg-[#525659] flex justify-center max-h-[450px] overflow-auto">
            <div class="w-[480px] bg-white p-5 text-slate-900 shadow text-[10px] space-y-2">
              <div class="text-center pb-2 border-b border-slate-900 font-bold">
                <div>महाराष्ट्र शासन · GOVERNMENT OF MAHARASHTRA</div>
                <div>VILLAGE FORM VII-XII (7/12 EXTRACT)</div>
              </div>
              <div class="grid grid-cols-2 gap-2 py-1 text-[9px]">
                <div>Registration No: <b><%= regNo %></b></div>
                <div>Serial No: <b>SR-4471/2024</b></div>
                <div>Village: <b><%= rec.village || 'Deolali' %></b></div>
                <div>District: <b><%= district %></b></div>
              </div>
              <table class="w-full border-collapse border border-slate-300 text-[9px]">
                <tr class="bg-slate-100"><td class="p-1 border border-slate-300">Survey No.</td><td class="p-1 border border-slate-300 font-bold"><%= survey %></td></tr>
                <tr><td class="p-1 border border-slate-300">Total Area</td><td class="p-1 border border-slate-300 font-bold"><%= area %></td></tr>
                <tr class="bg-slate-100"><td class="p-1 border border-slate-300">Occupant Name</td><td class="p-1 border border-slate-300 font-bold"><%= ownerName %></td></tr>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT 4 COLS: Decision Panel (Ref: PDF Page 10) -->
    <div class="lg:col-span-4 space-y-4">
      
      <div class="lrvs-card p-5 bg-white space-y-4">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Approve this verified land record?</h2>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">
            Approval publishes the record to the Citizen Portal and anchors a SHA-256 digest to the ledger. Your officer ID is recorded in the audit trail.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-2.5 pt-1">
          <!-- Primary Approve Button: Teal #207E85 -->
          <button type="button" onclick="submitDecision('APPROVE')"
                  class="btn-teal w-full py-2.5 px-4 text-xs font-bold rounded-lg shadow-sm flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Approve</span>
          </button>

          <!-- Reject Button: Outline subtle red -->
          <button type="button" onclick="submitDecision('REJECT')"
                  class="btn-outline w-full py-2.5 px-4 text-xs font-bold text-rose-600 border-[#E7EDEF] hover:bg-rose-50 rounded-lg flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            <span>Reject</span>
          </button>
        </div>

        <!-- Decision Metadata -->
        <div class="pt-4 border-t border-[#E7EDEF] space-y-2.5 text-xs text-slate-600">
          <div class="flex items-center justify-between">
            <span class="text-slate-400">Checked by</span>
            <span class="font-medium text-[#1A2A42]">Officer A. Deshmukh</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-400">Record integrity</span>
            <span class="font-mono text-slate-700">8a7f4c...c912e0</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-400">Duplicate check</span>
            <span class="text-emerald-700 font-medium">No match found</span>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<script>
async function submitDecision(action) {
  const alertEl = document.getElementById('actionAlert');
  const endpoint = action === 'APPROVE' 
    ? '/api/approvals/<%= approval._id %>/approve'
    : '/api/approvals/<%= approval._id %>/reject';

  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ remarks: action === 'APPROVE' ? 'Approved based on verified source records.' : 'Rejected' })
    });
    const data = await res.json();
    if (res.ok) {
      alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
      alertEl.textContent = action === 'APPROVE' 
        ? '✓ Record approved successfully! Anchored to ledger. Redirecting...'
        : 'Record rejected. Redirecting to queue...';
      setTimeout(() => { window.location.href = '/approvals/queue'; }, 1200);
    } else {
      alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
      alertEl.textContent = data.message || 'Action failed.';
    }
  } catch (err) {
    alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 block';
    alertEl.textContent = 'Network error: ' + err.message;
  }
}
</script>
