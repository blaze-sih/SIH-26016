<!-- Compensation Processing Detail (LRVS Design) -->
<div class="space-y-6">

  <!-- Header Dossier Banner -->
  <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-[#207E85]/10 text-[#207E85] border border-[#207E85]/20">Compensation Module</span>
        <h1 class="text-2xl font-bold font-mono tracking-tight text-[#1A2A42]"><%= record.requestId %></h1>
        <%- include('../partials/status-badge', { status: record.acquisitionStatus || record.status }) %>
      </div>
      <p class="text-base font-semibold text-[#1A2A42] mt-1"><%= record.projectName || 'Land Compensation Award' %></p>
      <p class="text-xs text-slate-500 mt-0.5">
        Survey No: <strong class="font-mono text-slate-700"><%= record.surveyNumber || '—' %></strong> • 
        Village: <strong class="text-slate-700"><%= record.village || '—' %></strong> • 
        District: <strong class="text-slate-700"><%= record.district || '—' %></strong>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a href="/land/<%= record.requestId %>" class="px-3.5 py-2 bg-white hover:bg-slate-50 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg shadow-sm transition">
        Full Dossier
      </a>
      <a href="/dashboard" class="px-3.5 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-semibold rounded-lg shadow-sm transition">
        Dashboard
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left 2 Cols: Land Parcel & Owner Details -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Parcel & Area -->
      <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
        <h2 class="text-base font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">Acquisition Parcel Summary</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
          <div>
            <span class="text-slate-400 font-medium">Acquired Area:</span>
            <p class="font-semibold text-[#1A2A42] mt-0.5"><%= record.area ? record.area.total + ' ' + (record.area.unit || '') : '—' %></p>
          </div>
          <div>
            <span class="text-slate-400 font-medium">Land Classification:</span>
            <p class="font-semibold text-[#1A2A42] mt-0.5"><%= record.landType || 'Agricultural' %></p>
          </div>
          <div>
            <span class="text-slate-400 font-medium">Affected Families:</span>
            <p class="font-semibold text-[#1A2A42] mt-0.5"><%= record.affectedFamilies || 0 %></p>
          </div>
        </div>
      </div>

      <!-- Beneficiaries / Owners List -->
      <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
        <h2 class="text-base font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">Beneficiary Awardees</h2>
        <% if (record.owners && record.owners.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Owner Name</th>
                <th>Share</th>
                <th>Contact</th>
              </tr>
            </thead>
            <tbody>
              <% record.owners.forEach((o, i) => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <td class="font-mono text-slate-400"><%= i + 1 %></td>
                <td class="font-medium text-[#1A2A42]"><%= o.name %></td>
                <td class="font-mono text-[#207E85] font-semibold"><%= o.share || '1/1' %></td>
                <td class="text-slate-600 font-mono"><%= o.contactNumber || '—' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>

      <!-- Cryptographic Ledger Anchor (Clean enterprise presentation) -->
      <% if (compensation && compensation.blockchainTxHash) { %>
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-2 text-xs">
        <div class="font-bold flex items-center gap-2 text-[#207E85]">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span class="text-[#1A2A42]">Compensation Disbursed & Security Anchored</span>
        </div>
        <div class="font-mono text-[11px] text-slate-500 break-all bg-slate-50 p-2.5 rounded border border-[#E7EDEF]">
          Transaction Hash: <%= compensation.blockchainTxHash %>
        </div>
        <div class="text-[11px] text-slate-400">
          Disbursed at: <%= compensation.paidAt ? new Date(compensation.paidAt).toLocaleString('en-IN') : 'Confirmed' %>
        </div>
      </div>
      <% } %>

    </div>

    <!-- Right Col: Financial Assessment Card -->
    <div class="space-y-6">

      <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
        <h2 class="text-base font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">Financial Award</h2>

        <% if (compensation) { %>
        <div class="space-y-3 text-xs">
          <div>
            <span class="text-slate-400 font-medium">Assessed Amount (INR):</span>
            <p class="font-bold font-mono text-[#1A2A42] text-lg mt-0.5">₹<%= (compensation.assessedAmount || 0).toLocaleString('en-IN') %></p>
          </div>

          <div>
            <span class="text-slate-400 font-medium">Approved Amount (INR):</span>
            <p class="font-bold font-mono text-emerald-700 text-lg mt-0.5">₹<%= (compensation.approvedAmount || compensation.assessedAmount || 0).toLocaleString('en-IN') %></p>
          </div>

          <div>
            <span class="text-slate-400 font-medium">Payment Status:</span>
            <div class="mt-1">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= compensation.paymentStatus === 'PAID' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                <%= compensation.paymentStatus || 'PENDING' %>
              </span>
            </div>
          </div>

          <div>
            <span class="text-slate-400 font-medium">Remarks:</span>
            <p class="text-slate-700 mt-0.5 p-3 rounded-lg bg-slate-50 border border-[#E7EDEF]"><%= compensation.remarks || 'Standard RFCTLARR valuation index.' %></p>
          </div>
        </div>
        <% } else { %>
        <div class="text-center py-8">
          <svg class="mx-auto h-10 w-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-[#1A2A42]">Compensation Not Yet Assessed</h3>
          <p class="mt-1 text-xs text-slate-500">Valuation assessment commences once central authority grants approval.</p>
        </div>
        <% } %>
      </div>

    </div>

  </div>

</div>
