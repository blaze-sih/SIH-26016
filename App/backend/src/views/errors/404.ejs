<div class="min-h-[60vh] flex flex-col items-center justify-center text-center p-6 space-y-4">
  <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold text-xl border border-slate-200">
    404
  </div>
  <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Record or Page Not Found</h1>
  <p class="text-sm text-slate-500 max-w-md">
    The requested resource could not be found. It may have been moved, deleted, or you might not have entered a valid URL.
  </p>
  <div class="pt-2 flex gap-3">
    <a href="/dashboard" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
      Return to Dashboard
    </a>
    <button onclick="history.back()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold rounded-lg transition">
      Go Back
    </button>
  </div>
</div>
