            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          <span class="truncate">My Land</span>
        </a>

        <!-- Documents -->
        <a href="#documents-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-[#243650] hover:text-white transition-colors">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span class="truncate">Documents</span>
        </a>

        <!-- Compensation -->
        <a href="#compensation-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-[#243650] hover:text-white transition-colors">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="truncate">Compensation</span>
        </a>

        <!-- Acquisition Status -->
        <a href="#status-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-[#243650] hover:text-white transition-colors">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>
          </svg>
          <span class="truncate">Acquisition Status</span>
        </a>

        <!-- Notifications -->
        <a href="#notifications" onclick="document.getElementById('navNotifBtn')?.click(); return false;" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-[#243650] hover:text-white transition-colors">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span class="truncate">Notifications</span>
        </a>

        <!-- Settings -->
        <a href="/profile" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/profile') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
          </svg>
          <span class="truncate">Settings</span>
        </a>

      <% /* ─── 5. SUPER ADMIN & OTHER ROLES ───────────────────────── */ %>
      <% } else { %>

        <% const adminDash = role === 'SUPER_ADMIN' ? '/dashboard/admin' : (role === 'VERIFICATION_OFFICER' ? '/dashboard/verification' : (role === 'FINANCE_OFFICER' ? '/dashboard/finance' : (role === 'PROJECT_OFFICER' ? '/dashboard/project-officer' : '/dashboard/land-owner'))); %>
        <a href="<%= adminDash %>" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls(adminDash) %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="truncate">Dashboard</span>
        </a>

        <a href="/land/requests" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/land/requests') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span class="truncate">Land Requests</span>
        </a>

        <% if (role === 'VERIFICATION_OFFICER' || role === 'SUPER_ADMIN') { %>
        <a href="/verification/queue" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/verification/queue') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="truncate">Verification Queue</span>
        </a>
        <% } %>

        <% if (role === 'SUPER_ADMIN' || role === 'FINANCE_OFFICER') { %>
        <a href="/compensation" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/compensation') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="truncate">Compensation</span>
        </a>
        <% } %>

        <a href="/audit" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/audit') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span class="truncate">Reports & Audit</span>
        </a>

        <a href="/profile" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm <%= linkCls('/profile') %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
          </svg>
          <span class="truncate">Settings</span>
        </a>

      <% } %>

    </nav>
  </div>

  <!-- Bottom Container: Government Identity & Subtle Logout -->
  <div class="flex-shrink-0 border-t border-[#243650] bg-[#162337]/90 px-4 py-3">
    <% if (role === 'LAND_OWNER') { %>
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white text-[#1A2A42] flex items-center justify-center font-bold text-sm flex-shrink-0 shadow-sm border border-slate-200">
            <%= (userName || 'Ramesh Patil').split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase() %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-white text-sm font-semibold leading-tight truncate"><%= userName %></div>
            <div class="text-slate-400 text-xs leading-tight truncate mt-0.5">Land Owner</div>
          </div>
        </div>
        <form action="/logout" method="POST" id="sidebarLogoutForm" class="pt-2 border-t border-[#243650]">
          <button type="submit" class="flex items-center gap-2.5 text-slate-400 hover:text-red-400 text-xs font-medium transition-colors w-full py-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Logout</span>
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="flex items-center gap-3">
        <!-- Ashoka Emblem SVG -->
        <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center text-slate-300">
          <svg class="w-7 h-7" viewBox="0 0 100 100" fill="currentColor">
            <!-- Stylized Ashoka Lion Capital Emblem Silhouette -->
            <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.4"/>
            <path d="M50 15 C45 22, 38 25, 32 30 C30 35, 32 40, 35 43 C32 47, 30 52, 32 58 C34 64, 40 68, 50 70 C60 68, 66 64, 68 58 C70 52, 68 47, 65 43 C68 40, 70 35, 68 30 C62 25, 55 22, 50 15 Z" fill="currentColor" opacity="0.85"/>
            <path d="M43 32 C41 33, 40 36, 42 38 C44 40, 48 38, 47 34 C46 32, 44 31, 43 32 Z M57 32 C56 31, 54 32, 53 34 C52 38, 56 40, 58 38 C60 36, 59 33, 57 32 Z" fill="#162337"/>
            <circle cx="50" cy="80" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="50" y1="72" x2="50" y2="88" stroke="currentColor" stroke-width="1.5"/>
            <line x1="42" y1="80" x2="58" y2="80" stroke="currentColor" stroke-width="1.5"/>
            <rect x="25" y="89" width="50" height="4" rx="2" fill="currentColor"/>
          </svg>
        </div>

        <!-- Identity Text matching exact screenshot -->
        <div class="flex-1 min-w-0">
          <% if (role === 'CENTRAL_AUTHORITY') { %>
            <div class="text-white text-xs font-semibold leading-tight truncate">Government of India</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate mt-0.5">Ministry of Land Resources</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate">Central Ministry</div>
          <% } else if (role === 'STATE_AUTHORITY') { %>
            <div class="text-white text-xs font-semibold leading-tight truncate">Government of Maharashtra</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate mt-0.5">Revenue and Forest Dept.</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate">Land Acquisition</div>
          <% } else if (role === 'DISTRICT_AUTHORITY') { %>
            <div class="text-white text-xs font-semibold leading-tight truncate">Government of Maharashtra</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate mt-0.5">District Collectorate</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate">Nashik</div>
          <% } else { %>
            <div class="text-white text-xs font-semibold leading-tight truncate">Government of Maharashtra</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate mt-0.5">Revenue Department</div>
            <div class="text-slate-400 text-[11px] leading-tight truncate">Land Records System</div>
          <% } %>
        </div>

        <!-- Logout icon button for sidebar -->
        <form action="/logout" method="POST" id="sidebarLogoutForm" class="flex-shrink-0">
          <button type="submit" title="Logout" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-red-400 hover:bg-[#243650] transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        </form>
      </div>
    <% } %>
  </div>

</aside>
