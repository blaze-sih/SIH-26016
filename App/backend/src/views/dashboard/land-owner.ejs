<!-- Land Owner Transparency Portal -->
<div class="space-y-6">

  <!-- ── Top Welcome Banner matching Image 1 ─────────────────────────────── -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
        Good Morning, <%= currentUser.name ? currentUser.name.split(' ')[0] : 'Ramesh' %> 
        <span class="inline-block animate-pulse">👋</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        Your land acquisition information is available here. You can view your land, documents and compensation status.
      </p>
    </div>
    
    <!-- Land Owner ID Badge matching Screenshot -->
    <div class="flex items-center gap-3 bg-emerald-50/70 border border-emerald-100 rounded-xl px-4 py-2.5 flex-shrink-0">
      <div class="w-9 h-9 rounded-lg bg-emerald-100/80 text-emerald-700 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <div>
        <div class="text-[11px] font-medium text-slate-400 leading-tight">Land Owner ID</div>
        <div class="text-sm font-bold text-slate-900 font-mono tracking-wide leading-tight mt-0.5">
          <%= currentUser.userId || 'LAND-001' %>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Top 4 Stat Cards matching Image 1 ─────────────────────────────────── -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Card 1: My Land Parcel -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative group">
      <div class="flex items-start justify-between">
        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
        </div>
        <a href="#land-location" class="text-slate-400 group-hover:text-slate-600 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="mt-4">
        <span class="text-xs font-semibold text-slate-500">My Land Parcel</span>
        <div class="text-2xl font-bold text-slate-900 mt-0.5" id="statParcelCount">
          <%= myRecords ? myRecords.length : 1 %>
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Total land parcel</span>
      </div>
    </div>

    <!-- Card 2: Documents -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative group">
      <div class="flex items-start justify-between">
        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <a href="#documents-section" class="text-slate-400 group-hover:text-slate-600 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="mt-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">Documents</span>
          <span id="docVerifiedBadge" class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Verified
          </span>
        </div>
        <div class="text-2xl font-bold text-slate-900 mt-0.5" id="statDocCount">
          <%= (typeof verifiedDocsCount !== 'undefined' && typeof totalDocsCount !== 'undefined') ? (verifiedDocsCount + ' / ' + totalDocsCount) : '8 / 8' %>
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Uploaded & Digitized</span>
      </div>
    </div>

    <!-- Card 3: Estimated Compensation -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative group">
      <div class="flex items-start justify-between">
        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xl">
          ₹
        </div>
        <a href="#compensation-section" class="text-slate-400 group-hover:text-slate-600 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="mt-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">Estimated Compensation</span>
        </div>
        <div class="text-2xl font-bold text-slate-900 mt-0.5">
          <%= typeof compensationFormatted !== 'undefined' ? compensationFormatted : '₹12.45 Lakh' %>
        </div>
        <div class="mt-1">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Under Process
          </span>
        </div>
      </div>
    </div>

    <!-- Card 4: Current Status -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative group">
      <div class="flex items-start justify-between">
        <div class="w-11 h-11 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
          </svg>
        </div>
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
      </div>
      <div class="mt-4">
        <span class="text-xs font-semibold text-slate-500">Current Status</span>
        <div class="text-lg font-bold text-slate-900 mt-0.5" id="displayCurrentStatus">
          Under Verification
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Next: Government Approval</span>
      </div>
    </div>

  </div>

  <!-- ── Middle Row: Your Land Location (Map) & Acquisition Progress Timeline ──── -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

    <!-- Left 8 Cols: Your Land Location Map Container -->
    <div id="land-location" class="lg:col-span-8 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Your Land Location</h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Survey No. <span id="mapSurveyNoText"><%= (activeRecord && activeRecord.surveyNumber) || '142/3' %></span>, <%= (activeRecord && activeRecord.village) || 'Sinnar' %>, <%= (activeRecord && activeRecord.district) || 'Nashik' %>, Maharashtra
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="zoomToParcel()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v3m0 14v3m10-10h-3M5 12H2"/>
              </svg>
              Recenter
            </button>
          </div>
        </div>

        <!-- Interactive Satellite Map Container -->
        <div class="relative w-full h-[360px] sm:h-[400px] rounded-xl overflow-hidden border border-slate-200 shadow-inner bg-slate-900">
          <div id="parcelMap" class="w-full h-full z-0"></div>

          <!-- Bottom Left Legend Overlay matching Image 1 -->
          <div class="absolute bottom-3 left-3 z-[400] bg-white/95 backdrop-blur-md px-3 py-2 rounded-lg shadow-md border border-slate-200/80 flex items-center gap-4 text-xs font-medium text-slate-700">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span>Your Land Parcel</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              <span>Surrounding Area</span>
            </div>
          </div>

          <!-- Bottom Right Button matching Image 1 -->
          <div class="absolute bottom-3 right-3 z-[400]">
            <a href="/map" class="px-3 py-2 bg-white/95 backdrop-blur-md hover:bg-white text-slate-800 text-xs font-semibold rounded-lg shadow-md border border-slate-200 transition-colors flex items-center gap-1.5">
              <span>View Full Map</span>
              <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right 4 Cols: Acquisition Progress Timeline Stepper -->
    <div id="status-section" class="lg:col-span-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900 pb-3 border-b border-slate-100">Acquisition Progress</h2>

        <!-- Vertical Stepper matching Image 1 -->
        <div class="mt-4 relative pl-7 space-y-6">
          <!-- Connecting vertical line -->
          <div class="absolute left-3 top-2.5 bottom-2.5 w-0.5 bg-slate-200 -translate-x-1/2 z-0"></div>

          <!-- Step 1: Application Submitted -->
          <div class="relative z-10">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Application Submitted</div>
              <div class="text-[11px] text-slate-400 mt-0.5">18 Sep 2026</div>
            </div>
          </div>

          <!-- Step 2: Documents Verified -->
          <div class="relative z-10">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Documents Verified</div>
              <div class="text-[11px] text-slate-400 mt-0.5">20 Sep 2026</div>
            </div>
          </div>

          <!-- Step 3: Field Survey Completed -->
          <div class="relative z-10">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Field Survey Completed</div>
              <div class="text-[11px] text-slate-400 mt-0.5">22 Sep 2026</div>
            </div>
          </div>

          <!-- Step 4: Government Approval (Active Review) -->
          <div class="relative z-10">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs shadow-md ring-4 ring-blue-100 animate-pulse">
              <span class="w-2 h-2 rounded-full bg-white"></span>
            </div>
            <div>
              <div class="text-xs font-bold text-blue-900">Government Approval</div>
              <div class="inline-block mt-1 px-2 py-0.5 bg-blue-50 text-blue-700 text-[11px] font-semibold rounded-md border border-blue-100">
                Currently Under Review
              </div>
            </div>
          </div>

          <!-- Step 5: Compensation Pending -->
          <div class="relative z-10 opacity-60">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-white border-2 border-slate-300 flex items-center justify-center text-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-700">Compensation</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Pending</div>
            </div>
          </div>

          <!-- Step 6: Possession & R&R Pending -->
          <div class="relative z-10 opacity-60">
            <div class="absolute -left-7 top-0 w-6 h-6 rounded-full bg-white border-2 border-slate-300 flex items-center justify-center text-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-700">Possession &amp; R&amp;R</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Pending</div>
            </div>
          </div>

        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
        <span class="text-slate-400">Target Completion:</span>
        <span class="font-bold text-slate-800">Dec 2026</span>
      </div>
    </div>

  </div>

  <!-- ── Bottom Row: My Land Details, Documents List & Compensation ────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Card 1: My Land Details matching Image 1 -->
    <div id="land-details" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
          <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">My Land Details</h2>
            <div class="text-[11px] text-slate-400">Official Revenue Record</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-5">
          <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-400 font-medium block">Survey Number</span>
            <span id="cardSurveyNumber" class="text-base font-bold text-slate-900 font-mono mt-0.5 block">
              <%= (activeRecord && activeRecord.surveyNumber) || '142/3' %>
            </span>
          </div>

          <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-400 font-medium block">Village</span>
            <span id="cardVillage" class="text-base font-bold text-slate-900 mt-0.5 block">
              <%= (activeRecord && activeRecord.village) || 'Sinnar' %>
            </span>
          </div>

          <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-400 font-medium block">District</span>
            <span id="cardDistrict" class="text-base font-bold text-slate-900 mt-0.5 block">
              <%= (activeRecord && activeRecord.district) || 'Nashik' %>
            </span>
          </div>

          <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-400 font-medium block">Area</span>
            <span id="cardLandArea" class="text-base font-bold text-slate-900 mt-0.5 block">
              <%= (activeRecord && activeRecord.area && activeRecord.area.total) || '45.2' %> Ha
            </span>
          </div>
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
        <span>Request ID: <strong class="text-slate-800 font-mono"><%= (activeRecord && activeRecord.requestId) || 'LA-2026-0245' %></strong></span>
        <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold">Active Parcel</span>
      </div>
    </div>

    <!-- Card 2: Documents List matching Image 1 -->
    <div id="documents-section" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-sm font-bold text-slate-900">Documents</h2>
              <div class="text-[11px] text-slate-400">Verification &amp; AI Extraction</div>
            </div>
          </div>
          <button onclick="openUploadModal()" class="px-2.5 py-1 text-xs font-semibold text-[#207E85] bg-teal-50 hover:bg-teal-100 rounded-lg transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Add</span>
          </button>
        </div>

        <!-- Documents List -->
        <div class="mt-4 space-y-3" id="docListContainer">
          <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
            <% documents.forEach((doc, idx) => { %>
              <div class="p-3 bg-slate-50/80 rounded-xl border border-slate-100 flex items-center justify-between hover:bg-slate-100/80 transition-colors group cursor-pointer"
                   onclick="openReviewModal('<%= doc.documentId %>', '<%= doc.documentType %>', '<%= doc.documentName || doc.documentType %>')">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-7 h-7 rounded-full <%= (doc.processingStatus === 'VERIFIED' || doc.verificationStatus === 'VERIFIED') ? 'bg-emerald-100 text-emerald-600' : (doc.processingStatus === 'REVIEW_REQUIRED' ? 'bg-amber-100 text-amber-600 animate-pulse' : 'bg-blue-100 text-blue-600') %> flex items-center justify-center flex-shrink-0 text-xs">
                    <% if (doc.processingStatus === 'VERIFIED' || doc.verificationStatus === 'VERIFIED') { %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                    <% } else if (doc.processingStatus === 'REVIEW_REQUIRED') { %>
                      <span class="font-bold">!</span>
                    <% } else { %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/>
                      </svg>
                    <% } %>
                  </div>
                  <div class="truncate">
                    <div class="text-xs font-semibold text-slate-800 truncate">
                      <%= doc.documentType === '7_12_EXTRACT' ? '7/12 Extract' : (doc.documentType === 'LAND_OWNERSHIP_RECORD' ? 'Land Ownership Record' : (doc.documentType === 'AADHAAR_VERIFICATION' ? 'Aadhaar Verification' : doc.documentType.replace(/_/g, ' '))) %>
                    </div>
                    <div class="text-[10px] text-slate-400 font-mono mt-0.5">
                      <%= doc.documentId %> · v<%= doc.currentVersion || 1 %>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2 flex-shrink-0">
                  <% if (doc.processingStatus === 'VERIFIED' || doc.verificationStatus === 'VERIFIED') { %>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-100 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Verified
                    </span>
                  <% } else if (doc.processingStatus === 'REVIEW_REQUIRED') { %>
                    <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-200 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> Review
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[10px] font-bold border border-blue-100">
                      <%= doc.processingStatus || 'UPLOADED' %>
                    </span>
                  <% } %>
                  <button type="button" class="text-slate-400 group-hover:text-[#207E85] transition-colors p-1" title="Review Document">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
