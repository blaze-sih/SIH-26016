<!-- Data Adder — New Property Request (Ref: PDF Page 6, 7, 8) -->
<div class="space-y-5">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-[#1A2A42]">New Property Request</h1>
      <p class="text-xs text-slate-500 mt-0.5">Register the source document, then run AI extraction before officer verification.</p>
    </div>
    <div class="self-start sm:self-auto">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-semibold bg-white border border-[#E7EDEF] text-slate-600 shadow-sm">
        Draft · REQ-20486
      </span>
    </div>
  </div>

  <!-- Main 2-Column Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
    
    <!-- LEFT 7 COLS: Form & Document Upload -->
    <div class="lg:col-span-7 space-y-5">
      
      <!-- Card 1: Record details -->
      <div class="lrvs-card p-5 bg-white space-y-4">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Record details</h2>
          <p class="text-[11px] text-slate-400 mt-0.5">Fields marked * are required.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">Registration Number *</label>
            <input type="text" id="regNo" name="registrationNumber" value="MH-NSK-2024-03291"
                   class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg bg-white text-[#1A2A42] font-mono focus:ring-1 focus:ring-[#207E85] focus:outline-none" />
            <p class="text-[10px] text-slate-400 mt-1">State-District-Year-Sequence, e.g. MH-NSK-2024-03291</p>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Serial Number *</label>
            <input type="text" id="serialNo" name="serialNumber" value="SR-4471/2024"
                   class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg bg-white text-[#1A2A42] font-mono focus:ring-1 focus:ring-[#207E85] focus:outline-none" />
          </div>

          <div class="sm:col-span-2">
            <label class="block font-semibold text-slate-700 mb-1">Source Document</label>
            <div class="relative">
              <select id="sourceDocSelect" name="documentType"
                      class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg bg-white text-[#1A2A42] focus:ring-1 focus:ring-[#207E85] focus:outline-none appearance-none">
                <option value="712_EXTRACT" selected>7/12 Extract (Satbara)</option>
                <option value="FORM_8A">Form 8A — Holding Register</option>
                <option value="SALE_DEED">Registered Sale Deed</option>
                <option value="MUTATION_ENTRY">Mutation Entry (Ferfar)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Source document upload (Ref: PDF Page 6) -->
      <div class="lrvs-card p-5 bg-white space-y-4">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Source document</h2>
          <p class="text-[11px] text-slate-400 mt-0.5">PDF, image (JPG/PNG) or DOC/DOCX · up to 20 MB</p>
        </div>

        <!-- Drag & Drop Zone -->
        <div class="border-2 border-dashed border-[#C5E1E3] bg-[#F8FAFB] hover:bg-[#F3F8F9] rounded-xl p-8 text-center transition cursor-pointer"
             onclick="document.getElementById('fileInput').click()">
          <input type="file" id="fileInput" class="hidden" accept=".pdf,.png,.jpg,.jpeg" onchange="handleFileSelected(event)" />
          <div class="w-10 h-10 rounded-full bg-[#E8F3F4] text-[#207E85] flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          </div>
          <p class="text-xs font-semibold text-[#1A2A42]">Drag and drop the source document here</p>
          <p class="text-[11px] text-slate-400 mt-0.5">or browse from your device</p>
          <button type="button" class="btn-outline mt-3 px-4 py-1.5 text-xs font-semibold">Choose file</button>
        </div>

        <!-- Uploaded File Item Preview -->
        <div id="fileItem" class="p-3 rounded-lg border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between text-xs">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-[10px]">
              PDF
            </div>
            <div>
              <div id="fileNameDisplay" class="font-medium text-[#1A2A42]">7-12-extract-118-2A.pdf</div>
              <div class="text-[11px] text-slate-400 flex items-center gap-1.5">
                <span>1.8 MB · Upload complete</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="text-slate-400 hover:text-slate-600 p-1" title="Refresh">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            </button>
            <button type="button" class="text-slate-400 hover:text-rose-600 p-1" title="Delete">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </div>

        <!-- File Ready status strip -->
        <div class="flex items-center justify-between text-xs pt-1">
          <div class="flex items-center gap-1.5 text-emerald-700 font-medium">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Ready for processing</span>
          </div>
          <a href="/verification/queue" class="text-[#207E85] hover:underline font-medium">Preview document</a>
        </div>
      </div>

      <!-- Lower Action Area (Ref: PDF Page 8) -->
      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button" class="btn-outline px-4 py-2 text-xs font-semibold">
          Save Draft
        </button>
        <button type="button" onclick="triggerAIProcessing()"
                class="btn-teal px-5 py-2 text-xs font-semibold flex items-center gap-2 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          <span>Process with AI</span>
        </button>
      </div>

    </div>

    <!-- RIGHT 5 COLS: AI Processing Status & Results -->
    <div class="lg:col-span-5 space-y-4">
      
      <!-- Card: AI Processing -->
      <div class="lrvs-card p-5 bg-white space-y-4">
        <h2 class="text-sm font-bold text-[#1A2A42]">AI Processing</h2>

        <!-- BEFORE AI PROCESSING STATE (Ref: PDF Page 6) -->
        <div id="aiStateInitial" class="space-y-4">
          <p class="text-xs text-slate-500 leading-relaxed">
            Extraction has not started. All output is always reviewed by an officer before approval — nothing is published automatically.
          </p>

          <!-- SOP Info box -->
          <div class="p-3 bg-[#F0F9FF] rounded-lg border border-[#BAE6FD] flex items-start gap-2 text-xs text-[#0369A1]">
            <svg class="w-4 h-4 text-[#0284C7] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-[11px] leading-relaxed">
              AI extraction assists the officer; it does not decide. Every field is verified against the source document in the Data Checker before a record can be approved.
            </span>
          </div>

          <!-- Demo: Preview a failure path -->
          <div class="p-4 bg-[#FFFBEB] rounded-xl border border-[#FDE68A] text-center space-y-2">
            <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center mx-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div class="font-bold text-xs text-amber-900">Preview a failure path</div>
            <p class="text-[11px] text-amber-800 leading-snug">
              Useful during the demo: run the pipeline and let normalisation fail.
            </p>
            <button type="button" onclick="simulateFailedExtraction()"
                    class="btn-outline border-amber-300 text-amber-900 hover:bg-amber-100 text-[11px] px-3 py-1.5 rounded-lg font-semibold mt-1">
              ✕ Simulate failed extraction
            </button>
          </div>
        </div>

        <!-- COMPLETED AI PROCESSING STATE (Ref: PDF Page 7 & 8) -->
        <div id="aiStateCompleted" class="hidden space-y-4">
          <!-- Progress info -->
          <div class="flex items-center justify-between text-xs text-slate-500">
            <span class="font-medium text-[#207E85]">Completed in 4.2s</span>
            <span class="font-bold text-[#1A2A42]">100%</span>
          </div>
          <div class="w-full bg-[#E7EDEF] rounded-full h-1.5 overflow-hidden">
            <div class="bg-[#207E85] h-1.5 rounded-full w-full"></div>
          </div>

          <!-- Extraction Steps -->
          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-2.5 text-xs">
              <div class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <div class="font-bold text-[#1A2A42]">Extract Fields</div>
                <div class="text-[11px] text-slate-400">Text and key fields pulled from source document</div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 text-xs">
              <div class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <div class="font-bold text-[#1A2A42]">Translate to English</div>
                <div class="text-[11px] text-slate-400">Applied only when source language requires it</div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 text-xs">
              <div class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <div class="font-bold text-[#1A2A42]">Normalize Fields</div>
                <div class="text-[11px] text-slate-400">Structured into a clean, consistent record</div>
              </div>
            </div>
          </div>

          <!-- AI Result Box (Ref: PDF Page 7) -->
          <div class="p-4 bg-[#F8FAFB] rounded-xl border border-[#E7EDEF] space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">AI RESULT</div>
                <div class="text-base font-extrabold text-[#1A2A42]">32 fields extracted</div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#FEF3C7] text-[#92400E] border border-[#FDE68A]">
                Ready for Check
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs pt-1 border-t border-[#E7EDEF]">
              <div>
                <span class="text-slate-400 block text-[10px]">Source language</span>
                <span class="font-medium text-[#1A2A42]">Marathi → English</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px]">Low-confidence fields</span>
                <span class="font-bold text-slate-800">3</span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-2 pt-2">
              <a href="/verification/queue" class="btn-teal w-full py-2.5 text-center text-xs block font-bold shadow-sm">
                First Check Data →
              </a>
              <a href="/verification/queue" class="btn-outline w-full py-2 text-center text-xs block font-semibold text-slate-700">
                Submit to Checker
              </a>
            </div>
          </div>

          <!-- SOP notice at bottom -->
          <div class="p-3 bg-[#F0F9FF] rounded-lg border border-[#BAE6FD] flex items-start gap-2 text-xs text-[#0369A1]">
            <svg class="w-4 h-4 text-[#0284C7] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-[11px] leading-relaxed">
              AI extraction assists the officer; it does not decide. Every field is verified against the source document in the Data Checker before a record can be approved.
            </span>
          </div>
        </div>

      </div>

    </div>

  </div>

</div>

<script>
function handleFileSelected(event) {
  const file = event.target.files[0];
  if (file) {
    document.getElementById('fileNameDisplay').textContent = file.name;
  }
}

function triggerAIProcessing() {
  document.getElementById('aiStateInitial').classList.add('hidden');
  document.getElementById('aiStateCompleted').classList.remove('hidden');
}

function simulateFailedExtraction() {
  alert('Simulated failure: OCR quality check failed due to low contrast on scan page 2. Record will require manual inspection in Data Checker.');
}
</script>

