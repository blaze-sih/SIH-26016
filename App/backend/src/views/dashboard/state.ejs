<script>
document.addEventListener('DOMContentLoaded', function() {

  // 1. Request Trend Multi-Line Chart
  const trendCtx = document.getElementById('stateTrendChart');
  if (trendCtx) {
    new Chart(trendCtx.getContext('2d'), {
      type: 'line',
      data: {
        labels: ['01 Aug', '03 Aug', '05 Aug', '07 Aug', '09 Aug', '11 Aug', '13 Aug'],
        datasets: [
          {
            label: 'Approved',
            data: [15, 22, 18, 32, 28, 38, 34],
            borderColor: '#10B981',
            backgroundColor: 'rgba(16, 185, 129, 0.08)',
            fill: true,
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Pending',
            data: [9, 14, 11, 22, 18, 26, 22],
            borderColor: '#F59E0B',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Under Review',
            data: [5, 9, 6, 14, 10, 18, 15],
            borderColor: '#3B82F6',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2.2,
            pointRadius: 0,
            pointHoverRadius: 5
          },
          {
            label: 'Rejected',
            data: [1, 3, 2, 4, 3, 5, 4],
            borderColor: '#EF4444',
            backgroundColor: 'transparent',
            tension: 0.42,
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 5
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index',
            intersect: false,
            backgroundColor: '#1A2A42',
            titleFont: { size: 11, weight: 'bold' },
            bodyFont: { size: 11 },
            padding: 8,
            cornerRadius: 6
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#94A3B8', font: { size: 10 } }
          },
          y: {
            min: 0,
            max: 40,
            ticks: { stepSize: 10, color: '#94A3B8', font: { size: 10 } },
            grid: { color: '#F1F5F9' }
          }
        }
      }
    });
  }

  // 2. Request Distribution Donut Chart
  const donutCtx = document.getElementById('stateDonutChart');
  if (donutCtx) {
    new Chart(donutCtx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Pending', 'Under Review', 'Approved', 'Rejected'],
        datasets: [{
          data: [16, 24, 48, 8],
          backgroundColor: ['#D97706', '#3B82F6', '#10B981', '#EF4444'],
          borderWidth: 3,
          borderColor: '#FFFFFF',
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '72%',
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1A2A42',
            padding: 8,
            cornerRadius: 6,
            callbacks: {
              label: function(context) {
                return ' ' + context.label + ': ' + context.parsed + ' requests';
              }
            }
          }
        }
      }
    });
  }

  // 3. Real Maharashtra GIS Map Initialization
  if (window.LRVS_GIS) {
    window.LRVS_GIS.initStateMap('stateMaharashtraMap', '<%= typeof googleMapsApiKey !== "undefined" ? googleMapsApiKey : "" %>');
  }

});
</script>
