<%# LRVS — Officer Dashboard | Team BLAZE | SIH26016 %>
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-[#1A2A42]">Officer Dashboard</h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Welcome back, <span class="font-semibold text-[#207E85]"><%= currentUser.name %></span> &middot;
        <span class="uppercase tracking-wide"><%= currentUser.userId %></span>
      </p>
    </div>
    <form action="/logout" method="POST">
      <button
        type="submit"
        class="px-4 py-2 text-xs font-semibold bg-white border border-[#E7EDEF] rounded-lg text-[#314155] hover:bg-rose-50 hover:border-rose-200 hover:text-rose-600 transition"
      >
        Sign Out
      </button>
    </form>
  </div>

  <!-- Officer Info Card -->
  <div class="bg-white rounded-xl border border-[#E7EDEF] p-6 flex items-start gap-4">
    <div class="w-11 h-11 rounded-lg bg-[#207E85]/10 border border-[#207E85]/20 flex items-center justify-center text-[#207E85] flex-shrink-0">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
      </svg>
    </div>
    <div>
      <div class="font-bold text-[#1A2A42] text-sm"><%= currentUser.name %></div>
      <div class="text-xs text-slate-500 mt-0.5">Officer ID: <span class="font-semibold uppercase"><%= currentUser.userId %></span></div>
      <div class="text-xs text-slate-500">Role: <span class="font-semibold uppercase"><%= currentUser.role %></span></div>
      <% if (currentUser.department) { %>
        <div class="text-xs text-slate-500">Department: <%= currentUser.department %></div>
      <% } %>
      <% if (currentUser.state) { %>
        <div class="text-xs text-slate-500">State: <%= currentUser.state %></div>
      <% } %>
      <% if (currentUser.district) { %>
        <div class="text-xs text-slate-500">District: <%= currentUser.district %></div>
      <% } %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <a href="/land/requests"
       class="bg-white rounded-xl border border-[#E7EDEF] p-5 hover:border-[#207E85] hover:shadow-sm transition group">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-[#207E85]/10 flex items-center justify-center text-[#207E85]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#1A2A42] group-hover:text-[#207E85] transition">Land Records</span>
      </div>
      <p class="text-xs text-slate-500">Browse and manage land acquisition requests.</p>
    </a>

    <a href="/verification/queue"
       class="bg-white rounded-xl border border-[#E7EDEF] p-5 hover:border-[#207E85] hover:shadow-sm transition group">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-[#207E85]/10 flex items-center justify-center text-[#207E85]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#1A2A42] group-hover:text-[#207E85] transition">Verification Queue</span>
      </div>
      <p class="text-xs text-slate-500">Review and verify field data against source documents.</p>
    </a>

    <a href="/approvals/queue"
       class="bg-white rounded-xl border border-[#E7EDEF] p-5 hover:border-[#207E85] hover:shadow-sm transition group">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-[#207E85]/10 flex items-center justify-center text-[#207E85]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#1A2A42] group-hover:text-[#207E85] transition">Approvals</span>
      </div>
      <p class="text-xs text-slate-500">Approve or reject pending land acquisition records.</p>
    </a>
  </div>

  <!-- Session Notice -->
  <div class="p-3 bg-white rounded-lg border border-[#E7EDEF] flex items-start gap-2.5 text-[11px] text-slate-500">
    <svg class="w-4 h-4 text-[#207E85] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
    </svg>
    <span>Sessions are encrypted and time-limited. All record actions are logged against your officer ID in the audit trail.</span>
  </div>

</div>
